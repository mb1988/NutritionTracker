# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public&sslmode=require"

# GitHub OAuth app credentials
GITHUB_ID="your-github-oauth-app-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-secret"

# Restrict sign-in to a single GitHub username
ALLOWED_GITHUB_USERNAME="your-github-username"

# NextAuth runtime configuration
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google sign-in (button appears only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Restrict Google sign-in to a single verified email
ALLOWED_GOOGLE_EMAIL=""

# Optional: AI meal assistant
OPENAI_API_KEY=""

# Optional: share rate-limit counters across instances
REDIS_URL=""

